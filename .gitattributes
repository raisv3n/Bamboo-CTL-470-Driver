# The repo is edited from macOS, Windows and Linux: store text as LF, check out Windows scripts as CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Golden files and captures must stay byte-identical across platforms.
shared/testdata/* text eol=lf -diff linguist-generated

*.png binary
*.ico binary
*.icns binary
